{
  "name": "dsh-finish-line",
  "version": "0.1.0",
  "description": "任务会话结束后自动串行跑收尾两步：组件化整理 → 批判式提交。",
  "license": "MIT",
  "meta": {
    "title": "收尾流水线",
    "description": "任务干完、排队输入清空后，自动串行执行「组件化整理」与「批判提交」；可跑子代理或新会话。"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gpboyer2/dsh-finish-line.git"
  },
  "homepage": "https://github.com/gpboyer2/dsh-finish-line#readme",
  "bugs": {
    "url": "https://github.com/gpboyer2/dsh-finish-line/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "finish-line",
    "auto-commit",
    "refactor"
  ],
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "test/"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5"
  }
}
